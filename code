function norm(s){return s.toLowerCase().replace(/[^a-z0-9]+/g,' ').replace(/\s+/g,' ').trim()}function match(a,b){a=norm(a);b=norm(b);if(!a||!b)return false;if(b.includes(a))return true;const aliases={cbc:['cbc','complete blood count','haemogram'],lft:['lft','liver function test'],kft:['kft','kidney function test'],ecg:['ecg','electrocardiogram'],hba1c:['hba1c','glycosylated hemoglobin','glycated hemoglobin'],psa:['psa','prostate specific antigen'],esr:['esr','erythrocyte sedimentation rate'],crp:['crp','c reactive protein'],tsh:['tsh','thyroid stimulation hormone']};return (aliases[a]||[]).some(x=>b.includes(norm(x)))}function esc(s){let d=document.createElement('div');d.textContent=s;return d.innerHTML}function packageAllowed(name,gender){
  const n=norm(name);
  const hasFemale=n.includes('female');
  const hasMale=n.includes('male');

  if(gender==='both') return true;
  if(gender==='female') return hasFemale || (!hasFemale && !hasMale);
  if(gender==='male') return hasMale || (!hasFemale && !hasMale);
  return true;
}
function findPackages(){
  let raw=document.getElementById('tests').value.trim(),
      out=document.getElementById('results'),
      gender=document.getElementById('gender').value;

  if(!raw){
    out.innerHTML='<div class="box empty">Please enter at least one test.</div>';
    return;
  }

  let selected=raw.split(',').map(x=>x.trim()).filter(Boolean),
      results=[];

  for(let [name,tests] of Object.entries(packages)){
    if(!packageAllowed(name,gender)) continue;

    let inc=[],exc=[];
    for(let input of selected){
      let found=tests.find(t=>match(input,t));
      found?inc.push(found):exc.push(input);
    }

    results.push({
      name:name,
      inc:inc,
      exc:exc,
      pct:inc.length/selected.length*100
    });
  }

  results.sort((a,b)=>b.pct-a.pct||b.inc.length-a.inc.length);

  if(!results.length){
    out.innerHTML='<div class="box empty">No packages are available for the selected gender.</div>';
    return;
  }

  out.innerHTML='<h2>Best Package Matches</h2>'+
    results.slice(0,4).map((r,i)=>`
      <div class="card">
        <div class="title">
          <h2>${i+1}. ${esc(r.name)}</h2>
          <span class="pct">${r.pct.toFixed(2)}%</span>
        </div>
        <div class="muted">${r.inc.length} of ${selected.length} requested tests matched</div>
        <div class="section">Included tests</div>
        <ul>${r.inc.length?r.inc.map(x=>`<li>${esc(x)}</li>`).join(''):'<li>None</li>'}</ul>
        <div class="section">Excluded tests</div>
        <ul>${r.exc.length?r.exc.map(x=>`<li>${esc(x)}</li>`).join(''):'<li>None</li>'}</ul>
      </div>`).join('');
}
function clearAll(){document.getElementById('tests').value='';document.getElementById('results').innerHTML=''}document.getElementById('tests').addEventListener('keydown',e=>{if(e.ctrlKey&&e.key==='Enter')findPackages()});</script></body></html>
